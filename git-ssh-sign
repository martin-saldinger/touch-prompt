#!/bin/sh
# git runs this as gpg.ssh.program. Signing with a FIDO key needs a touch,
# so show a full-screen prompt while ssh-keygen waits and retry missed touches.
# ssh-keygen reports "device not found" both when the key is unplugged and when
# an interrupted signature left it stuck; replugging the key fixes both.
# Run it with --preview [touch|missed|reconnect] to see a prompt without signing,
# or add a file path to save the prompt as a PNG instead.

keygen=/opt/homebrew/bin/ssh-keygen
prompt_bin="$(dirname "$0")/touch-prompt"
sound=/System/Library/Sounds/Glass.aiff
attempts=4
nl='
'
waiting() { echo "git is waiting for a signature${summary:+$nl$summary}"; }
missed() { echo "Missed it, try again ($1 of $attempts)${summary:+$nl$summary}"; }

if [ "$1" = "--preview" ]; then
  summary=$(git log -1 --format=%s 2>/dev/null)
  out=$3
  case ${2:-touch} in
    touch) set -- "Touch your YubiKey" "$(waiting)" 6 ;;
    missed) set -- "Touch your YubiKey" "$(missed 2)" 6 ;;
    reconnect) set -- "Reconnect your YubiKey" "Unplug it and plug it back in" 6 reconnect ;;
    *) echo "usage: $0 --preview [touch|missed|reconnect] [file.png]" >&2; exit 2 ;;
  esac
  [ -n "$out" ] && exec "$prompt_bin" --render "$out" "$@"
  afplay "$sound" &
  exec "$prompt_bin" "$@"
fi

[ "$1" = "-Y" ] && [ "$2" = "sign" ] || exec "$keygen" "$@"

err=$(mktemp)
trap 'rm -f "$err"' EXIT
trap 'kill "$prompt" 2>/dev/null; exit 1' INT TERM HUP
for buffer; do :; done
summary=$(awk 'NR == 1 && !/^tree / { exit } !body && /^$/ { body = 1; next } body { print; exit }' "$buffer")
subtitle=$(waiting)
attempt=1
while :; do
  afplay "$sound" &
  "$prompt_bin" "Touch your YubiKey" "$subtitle" 60 &
  prompt=$!
  "$keygen" "$@" 2>"$err"
  status=$?
  kill "$prompt" 2>/dev/null
  cat "$err" >&2
  [ $status -eq 0 ] && exit 0
  [ $attempt -ge $attempts ] && exit $status
  attempt=$((attempt + 1))
  if grep -q "device not found" "$err"; then
    afplay "$sound" &
    "$prompt_bin" "Reconnect your YubiKey" "Unplug it and plug it back in" 10 reconnect
    subtitle=$(waiting)
  else
    subtitle=$(missed $attempt)
  fi
done
